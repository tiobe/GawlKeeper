impl unit Switches

use

FileStream. Create, Close
ScanIO. AddInputFile, AddInputString
TextIO. Read, Eof
UnixArgs. NoOfArguments, GetArgument
UnixProcess. Exit, Failure, Success

Cyclox
RuleChecker
RuleConfig. InitRules, IsRule, IsRuleEnabled, ShowRules
StringTokenizer. Trim, Join
Version. LongVersion

typedef

Eof = {
  str : String = "\n$$$$$$\n"
  len : Int = #str
}

constant

EOF : Eof = Eof()

global

MySelf : String = "GawlKeeper"
NL: String = "\n"
SRCFILE : String|NIL := NIL
MIFB : List(String) := NIL 
MIFBGEN : Bool := FALSE

functions

Init()
{
  InitRules()
  ReadSwitches()
}

ReadSwitches()
{
  [ { ReadSwitch(GetArgument(i)) } | i : Int <- 1 .. (NoOfArguments() - 1) ]
  if SRCFILE = NIL then
    Usage()
    Exit(Failure)
  fi 
  if IsRuleEnabled("C033") & MIFB = NIL 
    { "E004: Argument '-mifb' is required to specify the available multi instance function blocks for rule C033\n" } astype Message
    Exit(Failure)
  fi
  if MIFBGEN & RuleChecker.IS_ENABLED
    { "E005: It is not possible to specify '-genmifb' and check rules at the same time\n" } astype Message
    Exit(Failure)
  else
    RuleChecker.IS_ENABLED := TRUE
  fi
    
}

ReadSwitch(sw : String)
{
  if sw@0 = '-' then
    GetSwitch(sw)
  else
    GetFile(sw)
  fi
}

GetSwitch(opt : String) {
  i : Int = opt > '='
  sw : String := opt
  arg : String := ""

  if i # -1 then
    sw := SubString(opt, 0, i - 1)
    arg := SubString(opt, i + 1, #opt - 1)
  fi
  if IsRule(sw) then
    // side effects are handled by IsRule function
    RuleChecker.IS_ENABLED := TRUE
  elsif sw == "-cyclox" then
    Cyclox.IS_ENABLED := TRUE
  elsif sw == "-genmifb" then
    MIFBGEN := TRUE
  elsif sw == "-help" then
    Usage()
    Exit(Success)
  elsif sw == "-mifb" then
    MIFB := ReadLines(arg)
  elsif sw == "-showrules" then
    ShowRules()
    Exit(Success)
  elsif sw == "-version" then
    Version()
    Exit(Success)
  else
    { "E001: Unknown option '" sw "' discarded" NL } astype Message
    Exit(Failure)
  fi
}

Version(): Output
{
  LongVersion(MySelf) NL
}

Usage(): Message
{
  "Usage" NL
  "  " MySelf " [<option>|<rule>]... <file>" NL NL
  "where <rule> is of the form" NL
  "  --<rule_nr> enables rule nr <rule_nr>" NL
  "  Example: --C007" NL
  "where <option> is of the form" NL
  "  -cyclox      calculate cyclomatic complexity of a file" NL
  "  -genmifb     generate multi-instance function blocks for a file" NL
  "  -help        show all possible options" NL
  "  -mifb=<file> file containing all multi-instance function blocks" NL
  "  -showrules   show a table of rules" NL
  "  -version     print version info and terminate" NL
  "and <file> is an AWL file" NL
}

GetFile(file : String)
conditions SRCFILE = NIL
{
  filename : Ident = Ident(file)

  AddInputFile(filename)
  AddInputString(EOF.str, EOF.len, filename)
  SRCFILE := file
}

GetFile(file : String)
{ { "E002: Only one input file is allowed\n"  } astype Message }

ReadLines(file : String): List(String)
{
  f : ReadFile := f

  if Create(file, f) then
    lines : List(String) := NIL

    while ~Eof(f) {
      line : String = Trim(Read(f))
      if line@0 # '\000' & line@0 # '/' then
        lines := line + lines
      fi
    }
    Close(f)
    //return Reverse(lines)
    return lines
  else
    { "E003: Failed to open file '" file "'" NL } astype Message
    return NIL
  fi
}
