      i_DB_RS_Upstr : DB_ANY := DB1;   // Data Structure: DB Route Segment upstream buffer
      i_DB_RS_Dwnstr_Straight : DB_ANY := DB1;   // Data Structure: DB Route Segment downstream straight (merge) buffer
