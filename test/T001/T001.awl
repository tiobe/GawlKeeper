      = #o_IDO99_ST_Init_Failure;
      A #s_IDO99_ST_Succ_No_Data;
      = #o_IDO99_ST_Succ_No_Data;
      A #s_IDO99_ST_Succ_Inv_Data;
      = #o_IDO99_ST_Succ_Inv_Data;

NETWORK
TITLE = WF: Write outputs TRS04
      NOP 0;

      A #s_TRS04_ST_LMS_Not_Prsnt;
      = #o_TRS04_ST_LMS_Not_Prsnt;
      A #s_TRS04_ST_LMS_Error;
      = #o_TRS04_ST_LMS_Error;
      A #s_TRS04_ST_LMS_Not_Auto;
      = #o_TRS04_ST_LMS_Not_Auto;
      A #s_TRS04_ST_LMS_Not_Hthy;
      = #o_TRS04_ST_LMS_Not_Hthy;
