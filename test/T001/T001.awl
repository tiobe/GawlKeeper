         i_CFG_PLC_LOG_BPI_Stat      := FALSE , 
         i_CFG_PLC_No_Msg_To_Rout    := FALSE , 
         i_CFG_PLC_No_Msg_To_BPI     := FALSE
      );

NETWORK
TITLE = MA: Handle TRS02 downstream (virtual) END PLT DB
//Manage the virtual End PLT DB with the default information. The virtual PLT DB should
//be connected downstream the loader conveyor and virtual PLT DB is an extension
//of TRS02 to handle the H2H function. The virtual PLT DB uses the default
//displacement calculated from TRS02 speed and default run signal. This is used
//to keep data shift in virtual PLT DB when the item is loaded in to carrier.
      NOP 0;

// Virtual transport section running
      SET;
      = #t_TRS02_Virtual_Run;

// Calculate default displacement for virtual End PLT DB
      L #t_TRS02_Displ;
      T #t_TRS02_Virtual_Displ;

// Open virtual End PLT DB
      OPN DB[ #t_TRS02_DB_PLT_End_Num];

// Set section run signal when TRS02 is running
      A #t_TRS02_Virtual_Run;
      = %DBX10.1;

// Set displacement of TRS02
      L #t_TRS02_Virtual_Displ;
      T %DBW2;

// Set required bits in PLT header
      SET;
      = %DBX10.0;// Set done bit in PLT header
      = %DBX10.2;// Set on speed signal in PLT Header
      = %DBX10.3;// Set cascade start-up signal in PLT Header

// Set section length for virtual PLT DB
      L #t_TRS02_PLT_End_Length;
      T %DBW12;

// Manage virtual PLT DB
      CALL #s_FB_Manage_PLT
      (  i_DB_PLT_Num                := #t_TRS02_DB_PLT_End_Num , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num , 
         i_Basic_Offset              := #t_TRS02_PLT_End_Length , 
         i_Dwnstr_PLT_Pos            := 0 , 
         i_Displacement              := #t_TRS02_Virtual_Displ , 
         i_CFG_Del_Window_Codes      := FALSE , 
         i_Section_Run               := #t_TRS02_Virtual_Run
      );

      CALL "FC_PLT_Clr_Range"
      (  i_DB_PLT_Num                := #t_TRS02_DB_PLT_End_Num , 
         i_Position                  := 15 , // (~ 2 PLC cycles(100ms) x 1,5m/s )
         i_Window                    := 15 , // Search until EOS
         i_DB_Event_Num              := #t_DB_Event_Zone_Num
      );

// Clear DB PLT when LMS is not automatic
      CALL "FC_PLT_Clr_DB"
      (  i_Enable_Clr                := #s_TRS02_ST_LMS_Not_Auto , 
         i_DB_PLT_Num                := #t_TRS02_DB_PLT_End_Num , 
         i_DB_Event_Num              := #t_DB_Event_Zone_Num
      );

NETWORK
TITLE = NA: TRS03 Interface with upstream section > inhibit receive item
//This function makes sure that the Loader is not dependent on flow control settings from upstream.
//By allowing only Carrier on the TRS03 at the time start stop behaviour is prevented.
      NOP 0;

// Search for Leading Edge on TRS03
      L #t_TRS03_Length;
      L "DB_Setting".Common_TTT.SBT_Length;
      -I;
      T #t_TRS03_Occupied_Pos;

      CALL "FC_PLT_Srch_Inf_Dwn"
      (  i_DB_PLT_Num                := #t_TRS03_DB_PLT_Num , 
         i_Position                  := #t_TRS03_Occupied_Pos , 
         i_Window                    := 20 , // (~ 2 PLC cycles(100ms) x 2m/s )
         i_Info                      := 1 , 
         o_Position                  := #t_Not_Used_Int , 
         o_Info                      := #t_TRS03_Fnd_Info_Lead , 
         o_LNK                       := #t_Not_Used_Int , 
         o_DB_PLT_Num                := #t_Not_Used_Int , 
         o_Number_Items_Found        := #t_Not_Used_Int
      );

      L #t_TRS03_Fnd_Info_Lead;
      L 0;
      >I;
      = #t_TRS03_Leading_Edge_Trigg;

// Search for Trailing Edge on TRS03
      CALL "FC_PLT_Srch_Inf_Dwn"
      (  i_DB_PLT_Num                := #t_TRS03_DB_PLT_Num , 
         i_Position                  := 45 , // determine average load cycle so trs03 don't go into dieback
         i_Window                    := 20 , // (~ 2 PLC cycles(100ms) x 2m/s )
         i_Info                      := 2 , 
         o_Position                  := #t_Not_Used_Int , 
         o_Info                      := #t_TRS03_Fnd_Info_Trail , 
         o_LNK                       := #t_Not_Used_Int , 
         o_DB_PLT_Num                := #t_Not_Used_Int , 
         o_Number_Items_Found        := #t_Not_Used_Int
      );

      L #t_TRS03_Fnd_Info_Trail;
      L 0;
      >I;
      = #t_TRS03_Trailing_Edge_Trigg;

// When Leading edge is found, set Inhibit Receive items from upstream
      A #t_TRS03_Leading_Edge_Trigg;
      S #s_TRS03_Inhibit_Receive_Item;

// When Trailing edge is found, Reset Inhibit Receive items
      A #t_TRS03_Trailing_Edge_Trigg;
      ON #t_TRS03_Operational;
      R #s_TRS03_Inhibit_Receive_Item;

// Set/Reset inhibit receive in PLT DB
      OPN DB[ #t_TRS03_DB_PLT_Num];
      A #s_TRS03_Inhibit_Receive_Item;
      = %DBX11.0;

NETWORK
TITLE = NB: TRS03: Speed select
      NOP 0;

// Trailing edge of carrier at end of section
      CALL "FC_PLT_Srch_Inf_Dwn"
      (  i_DB_PLT_Num                := #t_TRS03_DB_PLT_Num , 
         i_Position                  := #i_TRS03_Setting.Hardware.Speed2_Run_Out_Dist , 
         i_Window                    := #i_TRS03_Setting.Hardware.Speed2_Run_Out_Dist , 
         i_Info                      := 2 , 
         o_Position                  := #t_Not_Used_Int , 
         o_Info                      := #t_TRS03_Fnd_Info_Trail , 
         o_LNK                       := #t_Not_Used_Int , 
         o_DB_PLT_Num                := #t_Not_Used_Int , 
         o_Number_Items_Found        := #t_Not_Used_Int
      );

      L #t_TRS03_Fnd_Info_Trail;
      L 0;
      >I;
      = #t_TRS03_Carr_Trig_Trail;

// Leading edge of carrier at EOS
      CALL "FC_PLT_Srch_Inf_Dwn"
      (  i_DB_PLT_Num                := #t_TRS03_DB_PLT_Num , 
         i_Position                  := #i_TRS03_Setting.Hardware.Speed1_Run_Out_Dist , 
         i_Window                    := #i_TRS03_Setting.Hardware.Speed1_Run_Out_Dist , 
         i_Info                      := 1 , 
         o_Position                  := #t_Not_Used_Int , 
         o_Info                      := #t_TRS03_Fnd_Info_Lead , 
         o_LNK                       := #t_Not_Used_Int , 
         o_DB_PLT_Num                := #t_Not_Used_Int , 
         o_Number_Items_Found        := #t_Not_Used_Int
      );

      L #t_TRS03_Fnd_Info_Lead;
      L 0;
      >I;
      = #t_TRS03_Carr_Trig_Lead;

// Select 2nd speed when Leading edge on TRS03 is detected
      A #t_TRS03_Carr_Trig_Lead;
      S #s_TRS03_Req_2nd_Speed;

// Clear 2nd speed when carrier is handed over.
      A #t_TRS03_Carr_Trig_Trail;
      R #s_TRS03_Req_2nd_Speed;

// Load speed setting
      A #s_TRS03_Req_2nd_Speed;
      JCN NB01;

      L 2;
      T #t_TRS03_Select_Speed;
      JU NB99;

NB01:      L 1;
      T #t_TRS03_Select_Speed;

NB99:      NOP 0;

NETWORK
TITLE = NC: Transport Section TRS03
      NOP 0;

      A #i_IO_Available;
      AN #s_TRS03_ST_LMS_Not_Prsnt;
      AN #s_TRS03_ST_LMS_Error;
      = #t_TRS03_IO_Available;

      CALL #s_TRS03_FB_EQP_PEC_EOS
      (  i_Setting                   := #i_TRS03_Setting.PEC_1 , 
         i_DB_PLT                    := #i_TRS03_DB_PLT , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_Dwnstr_PLT_Pos            := 0 , 
         i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 15 , 
         i_CFG_Delay_Off_Filter      := 0 , 
         i_CFG_Flickering_Length     := 60 , 
         i_CFG_Min_Product_Length    := 60 , 
         i_CFG_Preset_PEC_Latch      := #s_TRS03_ST_LMS_Not_Auto , 
         i_CFG_Track_Present         := TRUE , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_IO_NOT_PEC                := #i_TRS03_IO_NOT_EOS_PEC , 
         i_Eqp_Available_IO          := #t_TRS03_IO_Available , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Disable_Update_Funct      := FALSE , 
         o_LPOS                      := #s_TRS03_EOS_PEC_LPOS , 
         o_PEC_Position              := #s_TRS03_EOS_PEC_Pos , 
         o_ST_PEC_Blk                := #s_TRS03_ST_EOS_PEC_Blk
      );

// Condition to request stop
      A #s_TRS03_ST_EOS_PEC_Blk;
      O #s_TRS03_ST_EOS_PEC_Miss;
      O #s_TRS03_ST_LMS_Not_Prsnt;
      O #s_TRS03_ST_LMS_Error;
      O #s_TRS03_ST_LMS_Not_Auto;
      O #s_TRS03_ST_LMS_Not_Hthy;
      = #s_TRS03_Ext_Req_Stop;

// Condition to request halt
      A #i_TRS03_Ext_Req_Halt;
      O #s_IDO99_Req_EQP_Halt_TRS;
      O #s_IDO99_Req_HW_Halt_TRS;
      = #s_TRS03_Ext_Req_Halt;

      CALL #s_TRS03_FB_EQP_Basic
      (  i_ID_Section                := #i_TRS03_ID , 
         i_Basic_Offset              := #i_TRS03_Setting.Basic.Offset , 
         i_DB_PLT                    := #i_TRS03_DB_PLT , 
         i_DB_PLT_DwnStr             := #i_TRS04_DB_PLT , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_Conveyor_Speed            := #s_TRS03_Selected_Speed , 
         i_Run_Out_Distance          := #s_TRS03_Selected_Run_Out , 
         i_Start_Up_Distance         := #s_TRS03_Selected_Startup , 
         i_Minimum_Gap               := #i_TRS03_Setting.Basic.Minimum_Gap , 
         i_Add_Gap_Stop              := #i_TRS03_Setting.Basic.Add_Gap_Stop , 
         i_Minimum_H2H               := #i_TRS03_Setting.Basic.Minimum_H2H , 
         i_Add_H2H_Stop              := #i_TRS03_Setting.Basic.Add_H2H_Stop , 
         i_CFG_Dieback_Position      := 0 , 
         i_CFG_Cascade_Delay_Time    := 30 , 
         i_CFG_Strt_Up_T_E_Save      := "DB_Setting".common.Start_Up_Time_E_Save , 
         i_CFG_Run_Out_E_Save        := "DB_Setting".common.Run_Out_Time_E_Save , 
         i_CFG_Stop_T_E_Save         := "DB_Setting".common.Stop_Time_E_Save , 
         i_PPI_Displacement          := 0 , 
         i_Dwnstr_PLT_Pos            := #s_IDO99_Pos , 
         i_CFG_Disbl_E_Save          := "DB_Setting".common.Disable_Energy_Saving , 
         i_CFG_Slave_Mode            := FALSE , 
         i_CFG_Del_Window_Codes      := FALSE , 
         i_Available_IO              := #i_IO_Available , 
         i_Safety_OK                 := #i_Safety_OK , 
         i_CMD_Enable                := #i_CMD_Enable , 
         i_CMD_Start                 := #i_CMD_Start , 
         i_Ext_Req_Stop              := #s_TRS03_Ext_Req_Stop , 
         i_Ext_Req_Halt              := #s_TRS03_Ext_Req_Halt , 
         i_Ext_Req_Dis_Send          := FALSE , 
         i_Ext_Req_Rst_ESave         := #i_TRS03_Ext_Req_Rst_ESav , 
         i_OS_Direction_Change       := FALSE , 
         i_Clr_PLT_Data              := #s_TRS03_ST_LMS_Not_Auto , 
         o_External                  := #o_TRS03_Ext_Outputs , 
         o_Motor_Run                 := #s_TRS03_Motor_Run , 
         o_ST_Items                  := #o_TRS03_ST_Items , 
         o_ST_Running                := #o_TRS03_ST_Running , 
         o_ST_Started                := #o_TRS03_ST_Started , 
         o_ST_Request_Halt           := #o_TRS03_ST_Req_Halt , 
         o_ST_Request_Stop           := #o_TRS03_ST_Req_Stop , 
         o_ST_External_Stop          := #o_TRS03_ST_Ext_Stop , 
         o_Ready_To_Restart          := #s_TRS03_Ready_To_Restart
      );

      CALL #s_TRS03_FB_TRK_Track_EOS
      (  i_Setting                   := #i_TRS03_Setting.Tracking , 
         i_DB_PLT                    := #i_TRS03_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Position_PEC_Update       := #s_TRS03_EOS_PEC_Pos , 
         i_LPOS                      := #s_TRS03_EOS_PEC_LPOS , 
         i_Length_Dif_Accepted       := 0 , 
         i_CFG_Num_Missing_Error     := 5 , 
         i_CFG_Upd_Perf_WN_Level     := 80 , 
         i_CFG_Weighing_Factor       := 10 , 
         i_CFG_Default_Record        := #t_Default_Rec_Upstr_IDO , 
         i_Trigger_Send_Stat         := #i_Send_Statistics , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CFG_Clear_Double_Data     := TRUE , 
         i_OS_Direction_Change       := FALSE , 
         i_HW_MTR_Not_Auto           := #s_TRS03_ST_LMS_Not_Auto , 
         i_Disable_Update_Funct      := FALSE , 
         o_ST_PEC_Miss               := #s_TRS03_ST_EOS_PEC_Miss , 
         o_ST_PEC_BadTrack           := #o_TRS03_ST_EOS_PEC_BadTr , 
         o_Update_Performance        := #t_Update_Performance , 
         o_Average_Slip              := #t_Average_Slip , 
         o_Number_Of_Items           := #t_Number_Of_Items , 
         o_OS_Data_Updated           := #t_OS_Data_Updated , 
         o_Data_Last_Update          := #t_Data_Last_Update , 
         o_Position_Last_Update      := #t_Position_Last_Update , 
         o_Deviation_Last_Update     := #t_Deviation_Last_Update
      );

      AN "M_Hardware_PN";
      JCN NC01;

      CALL #s_TRS03_FB_HW_MltSpd_LMS
      (  i_CMD_Send_Stat             := #i_Send_Statistics , 
         i_DB_PLT                    := #i_TRS03_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Speed1                    := #i_TRS03_Setting.Hardware.Speed1 , 
         i_Speed1_Run_Out_Dist       := #i_TRS03_Setting.Hardware.Speed1_Run_Out_Dist , 
         i_Speed1_Start_Up_Dist      := #i_TRS03_Setting.Hardware.Speed1_Start_Up_Dist , 
         i_Speed2                    := #i_TRS03_Setting.Hardware.Speed2 , 
         i_Speed2_Run_Out_Dist       := #i_TRS03_Setting.Hardware.Speed2_Run_Out_Dist , 
         i_Speed2_Start_Up_Dist      := #i_TRS03_Setting.Hardware.Speed2_Start_Up_Dist , 
         i_CFG_Motor_Switch_Time     := 0 , 
         i_CMD_Select_Speed          := #t_TRS03_Select_Speed , 
         i_Available_IO              := #i_IO_Available , 
         i_LMS_NotPrsnt              := #i_TRS03_LMS_Not_Prsnt , 
         i_LMS_Error                 := #i_TRS03_LMS_Error , 
         i_IO_LMS_Auto               := #i_TRS03_IO_LMS_Auto , 
         i_IO_LMS_Healthy            := #i_TRS03_IO_LMS_Healthy , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CMD_Req_Motor_Run         := #s_TRS03_Motor_Run , 
         i_CMD_Req_Motor_Reverse     := FALSE , 
         o_IO_MTR_Fwd                := #o_TRS03_IO_MTR_Fwd , 
         o_IO_MTR_Rev                := #o_TRS03_IO_MTR_Rev , 
         o_IO_Speed_Select1          := #o_TRS03_IO_Speed_Select1 , 
         o_IO_Speed_Select2          := #o_TRS03_IO_Speed_Select2 , 
         o_ST_ASI_NotPrsnt           := #s_TRS03_ST_LMS_Not_Prsnt , 
         o_ST_ASI_Err                := #s_TRS03_ST_LMS_Error , 
         o_ST_LMS_Not_Auto           := #s_TRS03_ST_LMS_Not_Auto , 
         o_ST_LMS_Not_Hthy           := #s_TRS03_ST_LMS_Not_Hthy , 
         o_Select_Conveyor_Speed     := #s_TRS03_Selected_Speed , 
         o_Select_Run_Out_Dist       := #s_TRS03_Selected_Run_Out , 
         o_Select_Started_Up_Dist    := #s_TRS03_Selected_Startup
      );

      JU NC03;

// By default use speed 1
NC01:      L #i_TRS03_Setting.Hardware.Speed1;
      T #t_TRS03_Speed;
      L #i_TRS03_Setting.Hardware.Speed1_Run_Out_Dist;
      T #t_TRS03_Run_Out_Dist;
      L #i_TRS03_Setting.Hardware.Speed1_Start_Up_Dist;
      T #t_TRS03_Start_Up_Dist;

// Determine if speed 2 is selected
      L #t_TRS03_Select_Speed;
      L 2;
      ==I;
      JCN NC02;

      L #i_TRS03_Setting.Hardware.Speed2;
      T #t_TRS03_Speed;
      L #i_TRS03_Setting.Hardware.Speed2_Run_Out_Dist;
      T #t_TRS03_Run_Out_Dist;
      L #i_TRS03_Setting.Hardware.Speed2_Start_Up_Dist;
      T #t_TRS03_Start_Up_Dist;

NC02:      CALL #s_TRS03_FB_HW_MTR_PN_LMS
      (  i_CMD_Send_Stat             := #i_Send_Statistics , 
         i_DB_PLT                    := #i_TRS03_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Speed                     := #t_TRS03_Speed , 
         i_Run_Out_Dist              := #t_TRS03_Run_Out_Dist , 
         i_Start_Up_Dist             := #t_TRS03_Start_Up_Dist , 
         i_CFG_Motor_Switch_Time     := 0 , 
         i_CFG_In_Hardw_ID           := #i_TRS03_CFG_LMS_In_Hardw_ID , 
         i_CFG_Out_Hardw_ID          := #i_TRS03_CFG_LMS_Out_Hardw_ID , 
         i_Available_IO              := #i_IO_Available , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CMD_Req_Motor_Run         := #s_TRS03_Motor_Run , 
         o_ST_FieldB_NotPrsnt        := #s_TRS03_ST_LMS_Not_Prsnt , 
         o_ST_FieldB_Error           := #s_TRS03_ST_LMS_Error , 
         o_ST_LMS_Not_Auto           := #s_TRS03_ST_LMS_Not_Auto , 
         o_ST_LMS_Not_Hthy           := #s_TRS03_ST_LMS_Not_Hthy , 
         o_Select_Conveyor_Speed     := #s_TRS03_Selected_Speed , 
         o_Select_Run_Out_Dist       := #s_TRS03_Selected_Run_Out , 
         o_Select_Started_Up_Dist    := #s_TRS03_Selected_Startup
      );

NC03:      NOP 0;

      CALL #s_TRS03_FB_DAT_T
      (  i_ID                        := #i_TRS03_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_DB_PLT_Lost_And_Found     := #i_DB_PLT_Lost_And_Found
      );

      CALL #s_TRS03_FB_DAT
      (  i_ID_Section                := #i_TRS03_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_PLC_Log_FIFO_DB           := "DB_LOG_Event_FIFO" , 
         i_CFG_BPI_Log_Level         := "DB_Setting".common.External_Log_Level , 
         i_CFG_PLC_Log_Level         := "DB_Setting".common.Internal_Log_Level , 
         i_CFG_PLC_Log_Route_Msgs    := FALSE , 
         i_CFG_PLC_LOG_BPI_Stat      := FALSE , 
         i_CFG_PLC_No_Msg_To_Rout    := FALSE , 
         i_CFG_PLC_No_Msg_To_BPI     := FALSE
      );

NETWORK
TITLE = OA: ID Reader Object IDO99
      NOP 0;

      CALL #s_IDO99_FB_EQP_IDO01_T
      (  i_Setting                   := #i_IDO99_Setting , 
         i_CMD_Enable                := #i_CMD_Enable , 
         i_CMD_Start                 := #i_CMD_Start , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CMD_Read_Stationary       := FALSE , 
         i_CMD_Dis_OnTheFly_Read     := FALSE , 
         i_Send_Statistics           := #i_Send_Statistics , 
         i_CFG_Default_Record        := #i_CFG_Default_Record_TTT , 
         i_CFG_Default_Record_ECS    := #i_CFG_Default_Record_ECS , 
         i_CFG_Common_SBT_Length     := "DB_Setting".Common_TTT.SBT_Length , 
         i_CFG_Succ_No_Data_Num      := 3 , 
         i_CFG_Succ_Inv_Data_Num     := 3 , 
         i_CFG_Restore_Requests      := FALSE , 
         i_CFG_Retrieve_Cntr_Flt     := FALSE , 
         i_CFG_Open_Window           := #i_IDO99_CFG_Open_Window , 
         i_CFG_Close_Window          := #i_IDO99_CFG_Close_Window , 
         i_Dwnstr_PLT_Pos            := #s_TRS03_EOS_PEC_Pos , 
         i_DB_PLT                    := #i_TRS03_DB_PLT , 
         i_DB_PLT_Non_Track          := #i_IDO99_DB_PLT_Non_Track , 
         i_DB_PLT_Lost_And_Found     := #i_DB_PLT_Lost_And_Found , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_OS_New_IDO_Data           := #s_IDO99_OS_New_IDO_Data , 
         i_IDO_Data                  := #s_IDO99_Data , 
         o_Req_Halt_TRS              := #s_IDO99_Req_EQP_Halt_TRS , 
         o_Ready_To_Restart          := #s_IDO99_EQP_Rdy_To_Start , 
         o_ST_No_Data                := #o_IDO99_ST_No_Data , 
         o_ST_Inv_Data               := #o_IDO99_ST_Inv_Data , 
         o_ST_Unex_Data              := #o_IDO99_ST_Unex_Data , 
         o_ST_Succ_No_Data           := #s_IDO99_ST_Succ_No_Data , 
         o_ST_Succ_Inv_Data          := #s_IDO99_ST_Succ_Inv_Data , 
         o_IDO_Pos                   := #s_IDO99_Pos , 
         o_Pos_Last_Read             := #t_Not_Used_Int , 
         o_Slip_Last_Read            := #t_Not_Used_Int
      );

      CALL #s_IDO99_FB_HW_IDO01_T
      (  i_CMD_Enable                := #i_CMD_Enable , 
         i_CMD_Start                 := #i_CMD_Start , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_IO_Available              := #i_IDO99_IO_Available , 
         i_CFG_In_Hardw_ID           := #i_IDO99_CFG_In_Hardw_ID , 
         i_CFG_Out_Hardw_ID          := #i_IDO99_CFG_Out_Hardw_ID , 
         i_CFG_Comm_Err_Delay        := 50 , 
         o_Req_Halt_TRS              := #s_IDO99_Req_HW_Halt_TRS , 
         o_Ready_To_Restart          := #s_IDO99_HW_Rdy_To_Start , 
         o_ST_PN_Not_Prsnt           := #s_IDO99_ST_PN_Not_Prsnt , 
         o_ST_PN_Error               := #s_IDO99_ST_PN_Error , 
         o_ST_Comm_Err               := #s_IDO99_ST_Comm_Err , 
         o_ST_IDR_Fault              := #s_IDO99_ST_IDR_Fault , 
         o_ST_Init_Failure           := #s_IDO99_ST_Init_Failure , 
         o_OS_New_IDO_Data           := #s_IDO99_OS_New_IDO_Data , 
         o_IDO_Data                  := #s_IDO99_Data
      );

      CALL #s_IDO99_FB_DAT_T
      (  i_ID                        := #i_IDO99_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_DB_PLT_Lost_And_Found     := #i_DB_PLT_Lost_And_Found
      );

      CALL #s_IDO99_FB_DAT
      (  i_ID_Section                := #i_IDO99_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_PLC_Log_FIFO_DB           := "DB_LOG_Event_FIFO" , 
         i_CFG_BPI_Log_Level         := "DB_Setting".common.External_Log_Level , 
         i_CFG_PLC_Log_Level         := "DB_Setting".common.Internal_Log_Level , 
         i_CFG_PLC_Log_Route_Msgs    := FALSE , 
         i_CFG_PLC_LOG_BPI_Stat      := FALSE , 
         i_CFG_PLC_No_Msg_To_Rout    := FALSE , 
         i_CFG_PLC_No_Msg_To_BPI     := FALSE
      );

NETWORK
TITLE = PA: Move carrier from upstream buffer to downstream buffer
//At the route segment transition the data has to be moved to the correct
//carrier buffer DB.
//The node position is chosen to be downstream the LIC transfer window
      NOP 0;

// Calculate node position
      L #t_TRS05_Length;
      L #i_TRS04_Setting.Hardware.Speed1_Run_Out_Dist;
      +I;
      L "DB_Setting".Common_TTT.SBT_Length;
      -I;
      T #t_Node_Position;

// Move carrier to route segment buffer DB
      CALL #s_FB_Rte_Seg_FIFO_T
      (  i_CFG_Position_Node         := #t_Node_Position , 
         i_CFG_Straight_Rte_Seg      := TRUE , 
         i_DB_PLT_Node               := #i_TRS05_DB_PLT , 
         i_DB_RS_Upstr               := #i_DB_RS_Upstr , 
         i_DB_RS_Dwnstr              := #i_DB_RS_Dwnstr , 
         i_DB_Event                  := "DB_Event_Section"
      );

NETWORK
TITLE = QA: Write log events
//Send log event for LDZ
      NOP 0;

      A #s_Carrier_Released;
      FP #s_FP_Carrier_Released;
      JCN QA99;

      CALL "FC_Read_Bool_Record"
      (  i_Record_Number             := #s_TIC_Released_Carrier , 
         i_P_BOOL_Record             := "DB_UDT_TIC_Record".TIR.Status_Loaded , 
         i_DB                        := "DB_TIC_List" , 
         i_DB_Event_Num              := #t_DB_Event_Zone_Num , 
         o_BOOL                      := #t_Loaded
      );

      CALL "FC_Read_Bool_Record"
      (  i_Record_Number             := #s_TIC_Released_Carrier , 
         i_P_BOOL_Record             := "DB_UDT_TIC_Record".TIR.Status_Empty , 
         i_DB                        := "DB_TIC_List" , 
         i_DB_Event_Num              := #t_DB_Event_Zone_Num , 
         o_BOOL                      := #t_Empty
      );

// Send Log event Good load
      A #t_Loaded;
      AN #t_Empty;
      JCN QA01;

      CALL "FC_Write_Event"
      (  i_Message_ID                := 3953 , 
         i_Event_value               := #s_TRS05_Fnd_LNK_Released_Carrier , 
         i_DB_Event_Num              := #t_DB_Event_Zone_Num , 
         o_Return_Value              := #t_Ret_Val_Int
      );

// Send carrier transport event - Load
      L 1;// 1 = AUTO
      T "DB_Outgoing_Msgs".Carr_Load.Body.Load.Method;

      CALL "FC_Write_Event"
      (  i_Message_ID                := 2707 , 
         i_Event_value               := #s_TRS05_Fnd_LNK_Released_Carrier , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num , 
         o_Return_Value              := #t_Ret_Val_Int
      );

// Send Log event Release On Request
QA01:      A #t_Requested_Operator;
      O #t_Requested_TFC;
      JCN QA99;

      CALL "FC_Write_Event"
      (  i_Message_ID                := 3851 , 
         i_Event_value               := #s_TRS05_Fnd_LNK_Released_Carrier , 
         i_DB_Event_Num              := #t_DB_Event_Zone_Num , 
         o_Return_Value              := #t_Ret_Val_Int
      );

QA99:      NOP 0;

NETWORK
TITLE = RA: Send tracking report
//A tracking report will be send at the same time (conditions) when the data is
//transfered from the bag to the carrier (load action completed).
      NOP 0;

// When the baggage is loaded in the carrier, Send Tracking Report
      A #t_Load_Action_Completed;
      O #t_Load_Action_Virt_Bag_Completed;
      FP #s_FP_Send_Track_Report;
      JCN RA99;

// Read report route number from LNK list
      CALL "FC_Read_Int_Record"
      (  i_Record_Number             := #s_Fnd_LNK_Carr_LP , 
         i_P_INT_Record              := "DB_UDT_LNK_Record".Rep_Route , 
         i_DB                        := "DB_LNK_List" , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num , 
         o_INT                       := #s_Rep_Route
      );

// Clear LNK from report route record
      L #s_Rep_Route;
      L 0;
      >I;
      JCN RA01;

      CALL "FC_Write_Int_Record"
      (  i_Record_Number             := #s_Rep_Route , 
         i_P_INT_Record              := "DB_UDT_Route_Record".LNK , 
         i_DB                        := "DB_Route_List" , 
         i_INT                       := 0 , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num
      );

// Clear report route record from LNK
RA01:      CALL "FC_Write_Int_Record"
      (  i_Record_Number             := #s_Fnd_LNK_Carr_LP , 
         i_P_INT_Record              := "DB_UDT_LNK_Record".Rep_Route , 
         i_DB                        := "DB_LNK_List" , 
         i_INT                       := 0 , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num
      );

// Generate new route record
      CALL "FC_Generator_LNK"
      (  i_LNK                       := #s_Fnd_LNK_Carr_LP , 
         i_DB_List                   := #t_DB_Route_List_Num , 
         i_Default_Record            := -1 , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num , 
         o_LNK                       := #s_Rep_Route
      );

// Read report route number from LNK list
      CALL "FC_Read_Int_Record"
      (  i_Record_Number             := #s_Fnd_LNK_Carr_LP , 
         i_P_INT_Record              := "DB_UDT_LNK_Record".Rep_Route , 
         i_DB                        := "DB_LNK_List" , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num , 
         o_INT                       := #s_Rep_Route
      );

// Use Bag LIC when load action is real bag
      A #t_Load_Action_Completed;
      JCN RA02;

// Copy BIR record from LIC list to route record
      CALL "FC_Read_ANY_Record"
      (  i_Record_Number             := #s_Fnd_LIC_Bag_LP , 
         i_ANY_Data_Record           := "DB_UDT_LIC_Record".BIR , 
         i_ANY_Data                  := "DB_Outgoing_Msgs".TrackingReport.Body.BIR , 
         i_DB                        := "DB_LIC_List" , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num
      );

// Use Virtual Bag LIC when load action is virtual bag
RA02:      A #t_Load_Action_Virt_Bag_Completed;
      JCN RA03;

// Copy BIR record from LIC list to route record
      CALL "FC_Read_ANY_Record"
      (  i_Record_Number             := #s_Fnd_LIC_Virt_Bag_LP , 
         i_ANY_Data_Record           := "DB_UDT_LIC_Record".BIR , 
         i_ANY_Data                  := "DB_Outgoing_Msgs".TrackingReport.Body.BIR , 
         i_DB                        := "DB_LIC_List" , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num
      );

RA03:      CALL "FC_Write_ANY_Record"
      (  i_Record_Number             := #s_Rep_Route , 
         i_ANY_Data_Record           := "DB_UDT_Route_Record".BIR , 
         i_ANY_Data                  := "DB_Outgoing_Msgs".TrackingReport.Body.BIR , 
         i_DB                        := "DB_Route_List" , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num
      );

// Write "decision level = 5" (TRANSPORT EQUIPMENT-DEFAULT DIRECTION) into report route record
      CALL "FC_Write_Int_Record"
      (  i_Record_Number             := #s_Rep_Route , 
         i_P_INT_Record              := "DB_UDT_Route_Record".SuccessDirection.DecisionLevel , 
         i_DB                        := "DB_Route_List" , 
         i_INT                       := 5 , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num
      );

// Write direction from 2 into report route record
      CALL "FC_Write_Int_Record"
      (  i_Record_Number             := #s_Rep_Route , 
         i_P_INT_Record              := "DB_UDT_Route_Record".SuccessDirection.DirectionFrom , 
         i_DB                        := "DB_Route_List" , 
         i_INT                       := 2 , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num
      );

// Write tracking report
      CALL "FC_Write_Event"
      (  i_Message_ID                := 1201 , 
         i_Event_value               := #s_Fnd_LNK_Carr_LP , 
         i_DB_Event_Num              := #t_DB_Event_Section_Num , 
         o_Return_Value              := #t_Ret_Val_Int
      );

RA99:      NOP 0;

NETWORK
TITLE = SA: Transport Section TRS04
      NOP 0;

      A #i_IO_Available;
      AN #s_TRS04_ST_LMS_Not_Prsnt;
      AN #s_TRS04_ST_LMS_Error;
      = #t_TRS04_IO_Available;

      CALL #s_TRS04_FB_EQP_PEC_EOS
      (  i_Setting                   := #i_TRS04_Setting.PEC_1 , 
         i_DB_PLT                    := #i_TRS04_DB_PLT , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_Dwnstr_PLT_Pos            := 0 , 
         i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 15 , 
         i_CFG_Delay_Off_Filter      := 0 , 
         i_CFG_Flickering_Length     := 60 , 
         i_CFG_Min_Product_Length    := 60 , 
         i_CFG_Preset_PEC_Latch      := #s_TRS04_ST_LMS_Not_Auto , 
         i_CFG_Track_Present         := TRUE , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_IO_NOT_PEC                := #i_TRS04_IO_NOT_EOS_PEC , 
         i_Eqp_Available_IO          := #t_TRS04_IO_Available , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Disable_Update_Funct      := FALSE , 
         o_LPOS                      := #s_TRS04_EOS_PEC_LPOS , 
         o_PEC_Position              := #s_TRS04_EOS_PEC_Pos , 
         o_ST_PEC_Blk                := #s_TRS04_ST_EOS_PEC_Blk , 
         o_PEC_Latch                 := #s_TRS04_EOS_PEC_Latch
      );

// Condition to request stop
      A #s_TRS04_ST_EOS_PEC_Blk;
      O #s_TRS04_ST_EOS_PEC_Miss;
      O #s_TRS04_ST_LMS_Not_Prsnt;
      O #s_TRS04_ST_LMS_Error;
      O #s_TRS04_ST_LMS_Not_Auto;
      O #s_TRS04_ST_LMS_Not_Hthy;
      = #s_TRS04_Ext_Req_Stop;

      CALL #s_TRS04_FB_EQP_Basic
      (  i_ID_Section                := #i_TRS04_ID , 
         i_Basic_Offset              := #i_TRS04_Setting.Basic.Offset , 
         i_DB_PLT                    := #i_TRS04_DB_PLT , 
         i_DB_PLT_DwnStr             := #i_TRS05_DB_PLT , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_Conveyor_Speed            := #s_TRS04_Selected_Speed , 
         i_Run_Out_Distance          := #s_TRS04_Selected_Run_Out , 
         i_Start_Up_Distance         := #s_TRS04_Selected_Startup , 
         i_Minimum_Gap               := #i_TRS04_Setting.Basic.Minimum_Gap , 
         i_Add_Gap_Stop              := #i_TRS04_Setting.Basic.Add_Gap_Stop , 
         i_Minimum_H2H               := #i_TRS04_Setting.Basic.Minimum_H2H , 
         i_Add_H2H_Stop              := #i_TRS04_Setting.Basic.Add_H2H_Stop , 
         i_CFG_Dieback_Position      := 0 , 
         i_CFG_Cascade_Delay_Time    := 30 , 
         i_CFG_Strt_Up_T_E_Save      := "DB_Setting".common.Start_Up_Time_E_Save , 
         i_CFG_Run_Out_E_Save        := "DB_Setting".common.Run_Out_Time_E_Save , 
         i_CFG_Stop_T_E_Save         := "DB_Setting".common.Stop_Time_E_Save , 
         i_PPI_Displacement          := 0 , 
         i_Dwnstr_PLT_Pos            := #s_TRS04_EOS_PEC_Pos , 
         i_CFG_Disbl_E_Save          := "DB_Setting".common.Disable_Energy_Saving , 
         i_CFG_Slave_Mode            := FALSE , 
         i_CFG_Del_Window_Codes      := FALSE , 
         i_Available_IO              := #i_IO_Available , 
         i_Safety_OK                 := #i_Safety_OK , 
         i_CMD_Enable                := #i_CMD_Enable , 
         i_CMD_Start                 := #i_CMD_Start , 
         i_Ext_Req_Stop              := #s_TRS04_Ext_Req_Stop , 
         i_Ext_Req_Halt              := FALSE , 
         i_Ext_Req_Dis_Send          := #s_TRS04_Ext_Req_Dis_Send , 
         i_Ext_Req_Rst_ESave         := FALSE , 
         i_OS_Direction_Change       := FALSE , 
         i_Clr_PLT_Data              := #s_TRS04_ST_LMS_Not_Auto , 
         o_External                  := #o_TRS04_Ext_Outputs , 
         o_Motor_Run                 := #s_TRS04_Motor_Run , 
         o_ST_Items                  := #o_TRS04_ST_Items , 
         o_ST_Running                := #o_TRS04_ST_Running , 
         o_ST_Started                := #o_TRS04_ST_Started , 
         o_ST_Request_Halt           := #o_TRS04_ST_Req_Halt , 
         o_ST_Request_Stop           := #o_TRS04_ST_Req_Stop , 
         o_ST_External_Stop          := #o_TRS04_ST_Ext_Stop , 
         o_Ready_To_Restart          := #s_TRS04_Ready_To_Restart
      );

      CALL #s_TRS04_FB_TRK_Track_EOS
      (  i_Setting                   := #i_TRS04_Setting.Tracking , 
         i_DB_PLT                    := #i_TRS04_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Position_PEC_Update       := #s_TRS04_EOS_PEC_Pos , 
         i_LPOS                      := #s_TRS04_EOS_PEC_LPOS , 
         i_Length_Dif_Accepted       := 0 , 
         i_CFG_Num_Missing_Error     := 5 , 
         i_CFG_Upd_Perf_WN_Level     := 80 , 
         i_CFG_Weighing_Factor       := 10 , 
         i_CFG_Default_Record        := #t_Default_Rec_Upstr_IDO , 
         i_Trigger_Send_Stat         := #i_Send_Statistics , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CFG_Clear_Double_Data     := TRUE , 
         i_OS_Direction_Change       := FALSE , 
         i_HW_MTR_Not_Auto           := #s_TRS04_ST_LMS_Not_Auto , 
         i_Disable_Update_Funct      := FALSE , 
         o_ST_PEC_Miss               := #s_TRS04_ST_EOS_PEC_Miss , 
         o_ST_PEC_BadTrack           := #o_TRS04_ST_EOS_PEC_BadTr , 
         o_Update_Performance        := #t_Update_Performance , 
         o_Average_Slip              := #t_Average_Slip , 
         o_Number_Of_Items           := #t_Number_Of_Items , 
         o_OS_Data_Updated           := #t_OS_Data_Updated , 
         o_Data_Last_Update          := #t_Data_Last_Update , 
         o_Position_Last_Update      := #t_Position_Last_Update , 
         o_Deviation_Last_Update     := #t_Deviation_Last_Update
      );

      AN "M_Hardware_PN";
      JCN SA01;

      CALL #s_TRS04_FB_HW_MltSpd_LMS
      (  i_CMD_Send_Stat             := #i_Send_Statistics , 
         i_DB_PLT                    := #i_TRS04_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Speed1                    := #i_TRS04_Setting.Hardware.Speed1 , 
         i_Speed1_Run_Out_Dist       := #i_TRS04_Setting.Hardware.Speed1_Run_Out_Dist , 
         i_Speed1_Start_Up_Dist      := #i_TRS04_Setting.Hardware.Speed1_Start_Up_Dist , 
         i_Speed2                    := 0 , 
         i_Speed2_Run_Out_Dist       := 0 , 
         i_Speed2_Start_Up_Dist      := 0 , 
         i_CFG_Motor_Switch_Time     := 0 , 
         i_CMD_Select_Speed          := 1 , 
         i_Available_IO              := #i_IO_Available , 
         i_LMS_NotPrsnt              := #i_TRS04_LMS_Not_Prsnt , 
         i_LMS_Error                 := #i_TRS04_LMS_Error , 
         i_IO_LMS_Auto               := #i_TRS04_IO_LMS_Auto , 
         i_IO_LMS_Healthy            := #i_TRS04_IO_LMS_Healthy , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CMD_Req_Motor_Run         := #s_TRS04_Motor_Run , 
         i_CMD_Req_Motor_Reverse     := FALSE , 
         o_IO_MTR_Fwd                := #o_TRS04_IO_MTR_Fwd , 
         o_IO_MTR_Rev                := #o_TRS04_IO_MTR_Rev , 
         o_IO_Speed_Select1          := #o_TRS04_IO_Speed_Select1 , 
         o_IO_Speed_Select2          := #o_TRS04_IO_Speed_Select2 , 
         o_ST_ASI_NotPrsnt           := #s_TRS04_ST_LMS_Not_Prsnt , 
         o_ST_ASI_Err                := #s_TRS04_ST_LMS_Error , 
         o_ST_LMS_Not_Auto           := #s_TRS04_ST_LMS_Not_Auto , 
         o_ST_LMS_Not_Hthy           := #s_TRS04_ST_LMS_Not_Hthy , 
         o_Select_Conveyor_Speed     := #s_TRS04_Selected_Speed , 
         o_Select_Run_Out_Dist       := #s_TRS04_Selected_Run_Out , 
         o_Select_Started_Up_Dist    := #s_TRS04_Selected_Startup
      );

      JU SA02;

SA01:      CALL #s_TRS04_FB_HW_MTR_PN_LMS
      (  i_CMD_Send_Stat             := #i_Send_Statistics , 
         i_DB_PLT                    := #i_TRS04_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Speed                     := #i_TRS04_Setting.Hardware.Speed1 , 
         i_Run_Out_Dist              := #i_TRS04_Setting.Hardware.Speed1_Run_Out_Dist , 
         i_Start_Up_Dist             := #i_TRS04_Setting.Hardware.Speed1_Start_Up_Dist , 
         i_CFG_Motor_Switch_Time     := 0 , 
         i_CFG_In_Hardw_ID           := #i_TRS04_CFG_LMS_In_Hardw_ID , 
         i_CFG_Out_Hardw_ID          := #i_TRS04_CFG_LMS_Out_Hardw_ID , 
         i_Available_IO              := #i_IO_Available , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CMD_Req_Motor_Run         := #s_TRS04_Motor_Run , 
         o_ST_FieldB_NotPrsnt        := #s_TRS04_ST_LMS_Not_Prsnt , 
         o_ST_FieldB_Error           := #s_TRS04_ST_LMS_Error , 
         o_ST_LMS_Not_Auto           := #s_TRS04_ST_LMS_Not_Auto , 
         o_ST_LMS_Not_Hthy           := #s_TRS04_ST_LMS_Not_Hthy , 
         o_Select_Conveyor_Speed     := #s_TRS04_Selected_Speed , 
         o_Select_Run_Out_Dist       := #s_TRS04_Selected_Run_Out , 
         o_Select_Started_Up_Dist    := #s_TRS04_Selected_Startup
      );

SA02:      NOP 0;

      CALL #s_TRS04_FB_DAT_T
      (  i_ID                        := #i_TRS04_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_DB_PLT_Lost_And_Found     := #i_DB_PLT_Lost_And_Found , 
         i_DB_Send_FIFO_PNPN         := #i_DB_Send_FIFO_PNPN
      );

      CALL #s_TRS04_FB_DAT
      (  i_ID_Section                := #i_TRS04_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_PLC_Log_FIFO_DB           := "DB_LOG_Event_FIFO" , 
         i_CFG_BPI_Log_Level         := "DB_Setting".common.External_Log_Level , 
         i_CFG_PLC_Log_Level         := "DB_Setting".common.Internal_Log_Level , 
         i_CFG_PLC_Log_Route_Msgs    := FALSE , 
         i_CFG_PLC_LOG_BPI_Stat      := FALSE , 
         i_CFG_PLC_No_Msg_To_Rout    := FALSE , 
         i_CFG_PLC_No_Msg_To_BPI     := FALSE
      );

NETWORK
TITLE = TA: TRS05 Speed select
      NOP 0;

// Check if carrier present in search window
      CALL "FC_PLT_Srch_Inf_Dwn"
      (  i_DB_PLT_Num                := #t_TRS04_DB_PLT_Num , 
         i_Position                  := 40 , // Position where load is completed (TRS02 has no longer overlap with TRS04)
         i_Window                    := 40 , 
         i_Info                      := 2 , 
         o_Position                  := #t_Not_Used_Int , 
         o_Info                      := #t_TRS04_Fnd_Info_Trail , 
         o_LNK                       := #t_Not_Used_Int , 
         o_DB_PLT_Num                := #t_Not_Used_Int , 
         o_Number_Items_Found        := #t_Not_Used_Int
      );

      L #t_TRS04_Fnd_Info_Trail;
      L 0;
      >I;
      = #t_TRS04_Carrier_Trail_Behind_LP;

// Set 2nd speed when carrier is after load point
      A #t_TRS04_Carrier_Trail_Behind_LP;
      S #s_TRS05_Req_2nd_Speed;

// Clear 2nd speed when carrier is leaving section
      A #t_TRS05_Item_At_HO;
      FN #s_FN_TRS05_Item_At_HO;// Use FN to make sure item has left TRS05
      R #s_TRS05_Req_2nd_Speed;

// Load speed setting
      A #s_TRS05_Req_2nd_Speed;
      JCN TA01;

      L 2;
      T #t_TRS05_Select_Speed;
      JU TA99;

TA01:      L 1;
      T #t_TRS05_Select_Speed;

TA99:      NOP 0;

NETWORK
TITLE = TB: Transport Section TRS05
      NOP 0;

      A #i_IO_Available;
      AN #s_TRS05_ST_LMS_Not_Prsnt;
      AN #s_TRS05_ST_LMS_Error;
      = #t_TRS05_IO_Available;

      CALL #s_TRS05_FB_EQP_PEC_EOS
      (  i_Setting                   := #i_TRS05_Setting.PEC_1 , 
         i_DB_PLT                    := #i_TRS05_DB_PLT , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_Dwnstr_PLT_Pos            := 0 , 
         i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 15 , 
         i_CFG_Delay_Off_Filter      := 0 , 
         i_CFG_Flickering_Length     := 60 , 
         i_CFG_Min_Product_Length    := 60 , 
         i_CFG_Preset_PEC_Latch      := #s_TRS05_ST_LMS_Not_Auto , 
         i_CFG_Track_Present         := TRUE , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_IO_NOT_PEC                := #i_TRS05_IO_NOT_EOS_PEC , 
         i_Eqp_Available_IO          := #t_TRS05_IO_Available , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Disable_Update_Funct      := FALSE , 
         o_LPOS                      := #s_TRS05_EOS_PEC_LPOS , 
         o_PEC_Position              := #s_TRS05_EOS_PEC_Pos , 
         o_ST_PEC_Blk                := #s_TRS05_ST_EOS_PEC_Blk
      );

// Condition to request stop
      A #s_TRS05_ST_EOS_PEC_Blk;
      O #s_TRS05_ST_EOS_PEC_Miss;
      O #s_TRS05_ST_LMS_Not_Prsnt;
      O #s_TRS05_ST_LMS_Error;
      O #s_TRS05_ST_LMS_Not_Auto;
      O #s_TRS05_ST_LMS_Not_Hthy;
      = #s_TRS05_Ext_Req_Stop;

// Condition to request halt
      A #s_CHO98_Req_Halt_TRS;
      = #s_TRS05_Ext_Req_Halt;

      CALL #s_TRS05_FB_EQP_Basic
      (  i_ID_Section                := #i_TRS05_ID , 
         i_Basic_Offset              := #i_TRS05_Setting.Basic.Offset , 
         i_DB_PLT                    := #i_TRS05_DB_PLT , 
         i_DB_PLT_DwnStr             := #i_DB_PLT_Dwnstr , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_Conveyor_Speed            := #s_TRS05_Selected_Speed , 
         i_Run_Out_Distance          := #s_TRS05_Selected_Run_Out , 
         i_Start_Up_Distance         := #s_TRS05_Selected_Startup , 
         i_Minimum_Gap               := #i_TRS05_Setting.Basic.Minimum_Gap , 
         i_Add_Gap_Stop              := #i_TRS05_Setting.Basic.Add_Gap_Stop , 
         i_Minimum_H2H               := #i_TRS05_Setting.Basic.Minimum_H2H , 
         i_Add_H2H_Stop              := #i_TRS05_Setting.Basic.Add_H2H_Stop , 
         i_CFG_Dieback_Position      := 0 , 
         i_CFG_Cascade_Delay_Time    := 0 , 
         i_CFG_Strt_Up_T_E_Save      := "DB_Setting".common.Start_Up_Time_E_Save , 
         i_CFG_Run_Out_E_Save        := "DB_Setting".common.Run_Out_Time_E_Save , 
         i_CFG_Stop_T_E_Save         := "DB_Setting".common.Stop_Time_E_Save , 
         i_PPI_Displacement          := 0 , 
         i_Dwnstr_PLT_Pos            := #s_TRS05_EOS_PEC_Pos , 
         i_CFG_Disbl_E_Save          := "DB_Setting".common.Disable_Energy_Saving , 
         i_CFG_Slave_Mode            := FALSE , 
         i_CFG_Del_Window_Codes      := FALSE , 
         i_Available_IO              := #i_IO_Available , 
         i_Safety_OK                 := #i_Safety_OK , 
         i_CMD_Enable                := #i_CMD_Enable , 
         i_CMD_Start                 := #i_CMD_Start , 
         i_Ext_Req_Stop              := #s_TRS05_Ext_Req_Stop , 
         i_Ext_Req_Halt              := #s_TRS05_Ext_Req_Halt , 
         i_Ext_Req_Dis_Send          := FALSE , 
         i_Ext_Req_Rst_ESave         := FALSE , 
         i_OS_Direction_Change       := FALSE , 
         i_Clr_PLT_Data              := #s_TRS05_ST_LMS_Not_Auto , 
         o_External                  := #o_TRS05_Ext_Outputs , 
         o_Motor_Run                 := #s_TRS05_Motor_Run , 
         o_ST_Items                  := #o_TRS05_ST_Items , 
         o_ST_Running                := #o_TRS05_ST_Running , 
         o_ST_Started                := #o_TRS05_ST_Started , 
         o_ST_Request_Halt           := #o_TRS05_ST_Req_Halt , 
         o_ST_Request_Stop           := #o_TRS05_ST_Req_Stop , 
         o_ST_External_Stop          := #o_TRS05_ST_Ext_Stop , 
         o_Ready_To_Restart          := #s_TRS05_Ready_To_Restart
      );

      CALL #s_TRS05_FB_TRK_Track_EOS
      (  i_Setting                   := #i_TRS05_Setting.Tracking , 
         i_DB_PLT                    := #i_TRS05_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Position_PEC_Update       := #s_TRS05_EOS_PEC_Pos , 
         i_LPOS                      := #s_TRS05_EOS_PEC_LPOS , 
         i_Length_Dif_Accepted       := 0 , 
         i_CFG_Num_Missing_Error     := 5 , 
         i_CFG_Upd_Perf_WN_Level     := 80 , 
         i_CFG_Weighing_Factor       := 10 , 
         i_CFG_Default_Record        := #i_CFG_Default_Record_TTT , 
         i_Trigger_Send_Stat         := #i_Send_Statistics , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CFG_Clear_Double_Data     := TRUE , 
         i_OS_Direction_Change       := FALSE , 
         i_HW_MTR_Not_Auto           := #s_TRS05_ST_LMS_Not_Auto , 
         i_Disable_Update_Funct      := FALSE , 
         o_ST_PEC_Miss               := #s_TRS05_ST_EOS_PEC_Miss , 
         o_ST_PEC_BadTrack           := #o_TRS05_ST_EOS_PEC_BadTr , 
         o_Update_Performance        := #t_Update_Performance , 
         o_Average_Slip              := #t_Average_Slip , 
         o_Number_Of_Items           := #t_Number_Of_Items , 
         o_OS_Data_Updated           := #t_OS_Data_Updated , 
         o_Data_Last_Update          := #t_Data_Last_Update , 
         o_Position_Last_Update      := #t_Position_Last_Update , 
         o_Deviation_Last_Update     := #t_Deviation_Last_Update
      );

      AN "M_Hardware_PN";
      JCN TB01;

      CALL #s_TRS05_FB_HW_MltSpd_LMS
      (  i_CMD_Send_Stat             := #i_Send_Statistics , 
         i_DB_PLT                    := #i_TRS05_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Speed1                    := #i_TRS05_Setting.Hardware.Speed1 , 
         i_Speed1_Run_Out_Dist       := #i_TRS05_Setting.Hardware.Speed1_Run_Out_Dist , 
         i_Speed1_Start_Up_Dist      := #i_TRS05_Setting.Hardware.Speed1_Start_Up_Dist , 
         i_Speed2                    := #i_TRS05_Setting.Hardware.Speed2 , 
         i_Speed2_Run_Out_Dist       := #i_TRS05_Setting.Hardware.Speed2_Run_Out_Dist , 
         i_Speed2_Start_Up_Dist      := #i_TRS05_Setting.Hardware.Speed2_Start_Up_Dist , 
         i_CFG_Motor_Switch_Time     := 0 , 
         i_CMD_Select_Speed          := #t_TRS05_Select_Speed , 
         i_Available_IO              := #i_IO_Available , 
         i_LMS_NotPrsnt              := #i_TRS05_LMS_Not_Prsnt , 
         i_LMS_Error                 := #i_TRS05_LMS_Error , 
         i_IO_LMS_Auto               := #i_TRS05_IO_LMS_Auto , 
         i_IO_LMS_Healthy            := #i_TRS05_IO_LMS_Healthy , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CMD_Req_Motor_Run         := #s_TRS05_Motor_Run , 
         i_CMD_Req_Motor_Reverse     := FALSE , 
         o_IO_MTR_Fwd                := #o_TRS05_IO_MTR_Fwd , 
         o_IO_MTR_Rev                := #o_TRS05_IO_MTR_Rev , 
         o_IO_Speed_Select1          := #o_TRS05_IO_Speed_Select1 , 
         o_IO_Speed_Select2          := #o_TRS05_IO_Speed_Select2 , 
         o_ST_ASI_NotPrsnt           := #s_TRS05_ST_LMS_Not_Prsnt , 
         o_ST_ASI_Err                := #s_TRS05_ST_LMS_Error , 
         o_ST_LMS_Not_Auto           := #s_TRS05_ST_LMS_Not_Auto , 
         o_ST_LMS_Not_Hthy           := #s_TRS05_ST_LMS_Not_Hthy , 
         o_Select_Conveyor_Speed     := #s_TRS05_Selected_Speed , 
         o_Select_Run_Out_Dist       := #s_TRS05_Selected_Run_Out , 
         o_Select_Started_Up_Dist    := #s_TRS05_Selected_Startup
      );

      JU TB03;

// By default use speed 1
TB01:      L #i_TRS05_Setting.Hardware.Speed1;
      T #t_TRS05_Speed;
      L #i_TRS05_Setting.Hardware.Speed1_Run_Out_Dist;
      T #t_TRS05_Run_Out_Dist;
      L #i_TRS05_Setting.Hardware.Speed1_Start_Up_Dist;
      T #t_TRS05_Start_Up_Dist;

// Determine if speed 2 is selected
      L #t_TRS05_Select_Speed;
      L 2;
      ==I;
      JCN TB02;

      L #i_TRS05_Setting.Hardware.Speed2;
      T #t_TRS05_Speed;
      L #i_TRS05_Setting.Hardware.Speed2_Run_Out_Dist;
      T #t_TRS05_Run_Out_Dist;
      L #i_TRS05_Setting.Hardware.Speed2_Start_Up_Dist;
      T #t_TRS05_Start_Up_Dist;

TB02:      CALL #s_TRS05_FB_HW_MTR_PN_LMS
      (  i_CMD_Send_Stat             := #i_Send_Statistics , 
         i_DB_PLT                    := #i_TRS05_DB_PLT , 
         i_Event_DB                  := "DB_Event_Section" , 
         i_Speed                     := #t_TRS05_Speed , 
         i_Run_Out_Dist              := #t_TRS05_Run_Out_Dist , 
         i_Start_Up_Dist             := #t_TRS05_Start_Up_Dist , 
         i_CFG_Motor_Switch_Time     := 0 , 
         i_CFG_In_Hardw_ID           := #i_TRS05_CFG_LMS_In_Hardw_ID , 
         i_CFG_Out_Hardw_ID          := #i_TRS05_CFG_LMS_Out_Hardw_ID , 
         i_Available_IO              := #i_IO_Available , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_CMD_Req_Motor_Run         := #s_TRS05_Motor_Run , 
         o_ST_FieldB_NotPrsnt        := #s_TRS05_ST_LMS_Not_Prsnt , 
         o_ST_FieldB_Error           := #s_TRS05_ST_LMS_Error , 
         o_ST_LMS_Not_Auto           := #s_TRS05_ST_LMS_Not_Auto , 
         o_ST_LMS_Not_Hthy           := #s_TRS05_ST_LMS_Not_Hthy , 
         o_Select_Conveyor_Speed     := #s_TRS05_Selected_Speed , 
         o_Select_Run_Out_Dist       := #s_TRS05_Selected_Run_Out , 
         o_Select_Started_Up_Dist    := #s_TRS05_Selected_Startup
      );

TB03:      NOP 0;

      CALL #s_TRS05_FB_DAT_T
      (  i_ID                        := #i_TRS05_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_DB_PLT_Lost_And_Found     := #i_DB_PLT_Lost_And_Found , 
         i_DB_Send_FIFO_PNPN         := #i_DB_Send_FIFO_PNPN
      );

      CALL #s_TRS05_FB_DAT
      (  i_ID_Section                := #i_TRS05_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_PLC_Log_FIFO_DB           := "DB_LOG_Event_FIFO" , 
         i_CFG_BPI_Log_Level         := "DB_Setting".common.External_Log_Level , 
         i_CFG_PLC_Log_Level         := "DB_Setting".common.Internal_Log_Level , 
         i_CFG_PLC_Log_Route_Msgs    := FALSE , 
         i_CFG_PLC_LOG_BPI_Stat      := FALSE , 
         i_CFG_PLC_No_Msg_To_Rout    := FALSE , 
         i_CFG_PLC_No_Msg_To_BPI     := FALSE
      );

NETWORK
TITLE = UA: Check Object CH098
      NOP 0;

// ASi slave 1 IO available
      A #i_IO_Available;
      AN #s_CHO98_ST_FieldB1_NotPrsnt;
      AN #s_CHO98_ST_FieldB1_Error;
      = #t_CHO98_FieldB1_IO_Avail;

// ASi slave 2 IO available
      A #i_IO_Available;
      AN #s_CHO98_ST_FieldB2_NotPrsnt;
      AN #s_CHO98_ST_FieldB2_Error;
      = #t_CHO98_FieldB2_IO_Avail;

// Trigger PEC
      CALL #s_CHO98_FB_EQP_PEC_Trg
      (  i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 0 , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_CFG_Time_Displacement     := TRUE , 
         i_IO_NOT_PEC                := #i_CHO98_IO_NOT_Trg_PEC , 
         i_Eqp_Available_IO          := #t_CHO98_FieldB1_IO_Avail , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Displacement              := #t_TRS05_Displ , 
         o_ST_PEC_Blk                := #s_CHO98_ST_Trg_PEC_Blk , 
         o_PEC_Flap_Filter           := #s_CHO98_Trg_PEC_Latch
      );

// Gap PEC
      CALL #s_CHO98_FB_EQP_PEC_Gap
      (  i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 0 , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_CFG_Time_Displacement     := TRUE , 
         i_IO_NOT_PEC                := #i_CHO98_IO_NOT_Gap_PEC , 
         i_Eqp_Available_IO          := #t_CHO98_FieldB1_IO_Avail , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Displacement              := #t_TRS05_Displ , 
         o_ST_PEC_Blk                := #s_CHO98_ST_Gap_PEC_Blk , 
         o_PEC_Flap_Filter           := #s_CHO98_Gap_PEC_Latch
      );

// Content PEC left
      CALL #s_CHO98_FB_EQP_PECT_ConL
      (  i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 0 , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_CFG_Time_Displacement     := TRUE , 
         i_IO_NOT_PEC                := #i_CHO98_IO_NOT_Con_L_PEC , 
         i_Eqp_Available_IO          := #t_CHO98_FieldB1_IO_Avail , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Displacement              := #t_TRS05_Displ , 
         o_ST_PEC_Blk                := #s_CHO98_ST_Con_L_PEC_Blk , 
         o_PEC_Flap_Filter           := #s_CHO98_CON_L_PEC_Latch
      );

// Content PEC right
      CALL #s_CHO98_FB_EQP_PECT_ConR
      (  i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 0 , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_CFG_Time_Displacement     := TRUE , 
         i_IO_NOT_PEC                := #i_CHO98_IO_NOT_Con_R_PEC , 
         i_Eqp_Available_IO          := #t_CHO98_FieldB1_IO_Avail , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Displacement              := #t_TRS05_Displ , 
         o_ST_PEC_Blk                := #s_CHO98_ST_Con_R_PEC_Blk , 
         o_PEC_Flap_Filter           := #s_CHO98_CON_R_PEC_Latch
      );

// Length PEC
      CALL #s_CHO98_FB_EQP_PECT_Len
      (  i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 0 , 
         i_CFG_Reset_Block_PEC_Oc    := TRUE , 
         i_CFG_Time_Displacement     := TRUE , 
         i_IO_NOT_PEC                := #i_CHO98_IO_NOT_Len_PEC , 
         i_Eqp_Available_IO          := #t_CHO98_FieldB2_IO_Avail , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Displacement              := #t_TRS05_Displ , 
         o_ST_PEC_Blk                := #s_CHO98_ST_Len_PEC_Blk , 
         o_PEC_Flap_Filter           := #s_CHO98_Len_PEC_Latch
      );

// Height PEC
      CALL #s_CHO98_FB_EQP_PECT_Hght
      (  i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 0 , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_CFG_Time_Displacement     := TRUE , 
         i_IO_NOT_PEC                := #i_CHO98_IO_NOT_Hght_PEC , 
         i_Eqp_Available_IO          := #t_CHO98_FieldB2_IO_Avail , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Displacement              := #t_TRS05_Displ , 
         o_ST_PEC_Blk                := #s_CHO98_ST_Hght_PEC_Blk , 
         o_PEC_Flap_Filter           := #s_CHO98_Hght_PEC_Latch
      );

// Width PEC left
      CALL #s_CHO98_FB_EQP_PECT_WthL
      (  i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 0 , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_CFG_Time_Displacement     := TRUE , 
         i_IO_NOT_PEC                := #i_CHO98_IO_NOT_Wth_L_PEC , 
         i_Eqp_Available_IO          := #t_CHO98_FieldB2_IO_Avail , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Displacement              := #t_TRS05_Displ , 
         o_ST_PEC_Blk                := #s_CHO98_ST_Wth_L_PEC_Blk , 
         o_PEC_Flap_Filter           := #s_CHO98_Wth_L_PEC_Latch
      );

// Width PEC right
      CALL #s_CHO98_FB_EQP_PECT_WthR
      (  i_CFG_Blockage_Length       := #i_CFG_Blockage_Length , 
         i_CFG_Delay_On_Filter       := 0 , 
         i_CFG_Reset_Block_PEC_Oc    := FALSE , 
         i_CFG_Time_Displacement     := TRUE , 
         i_IO_NOT_PEC                := #i_CHO98_IO_NOT_Wth_R_PEC , 
         i_Eqp_Available_IO          := #t_CHO98_FieldB2_IO_Avail , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Displacement              := #t_TRS05_Displ , 
         o_ST_PEC_Blk                := #s_CHO98_ST_Wth_R_PEC_Blk , 
         o_PEC_Flap_Filter           := #s_CHO98_Wth_R_PEC_Latch
      );

// Request Halt
      A #s_CHO98_ST_FieldB1_NotPrsnt;
      O #s_CHO98_ST_FieldB1_Error;
      O #s_CHO98_ST_FieldB2_NotPrsnt;
      O #s_CHO98_ST_FieldB2_Error;
      O #s_CHO98_ST_Trg_PEC_Blk;
      O #s_CHO98_ST_Gap_PEC_Blk;
      O #s_CHO98_ST_Con_L_PEC_Blk;
      O #s_CHO98_ST_Con_R_PEC_Blk;
      O #s_CHO98_ST_Len_PEC_Blk;
      O #s_CHO98_ST_Hght_PEC_Blk;
      O #s_CHO98_ST_Wth_L_PEC_Blk;
      O #s_CHO98_ST_Wth_R_PEC_Blk;
      = #s_CHO98_Req_Halt;

      CALL #s_CHO98_FB_EQP_CHO06_T
      (  i_ID                        := #i_CHO98_ID , 
         i_CMD_Enable                := #i_CMD_Enable , 
         i_CMD_Start                 := #i_CMD_Start , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Setting                   := #i_CHO98_Setting , 
         i_IO_Available              := #i_IO_Available , 
         i_Ext_Req_Halt              := #s_CHO98_Req_Halt , 
         i_Send_Statistics           := #i_Send_Statistics , 
         i_CFG_Default_Record        := #i_CFG_Default_Record_LIC , 
         i_CFG_Unex_Empty_Num        := 3 , 
         i_CFG_Unex_Loaded_Num       := 3 , 
         i_CFG_Open_Srch_Win         := 40 , 
         i_CFG_Close_Srch_Win        := 80 , 
         i_TRS01_DB_PLT              := #i_TRS05_DB_PLT , 
         i_TRS02_DB_PLT              := #i_DB_PLT_Dwnstr , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_Trg_PEC_Latch             := #s_CHO98_Trg_PEC_Latch , 
         i_Gap_PEC_Latch             := #s_CHO98_Gap_PEC_Latch , 
         i_Con_L_PEC_Latch           := #s_CHO98_CON_L_PEC_Latch , 
         i_Con_R_PEC_Latch           := #s_CHO98_CON_R_PEC_Latch , 
         i_Len_PEC_Latch             := #s_CHO98_Len_PEC_Latch , 
         i_Hght_PEC_Latch            := #s_CHO98_Hght_PEC_Latch , 
         i_Wth_L_PEC_Latch           := #s_CHO98_Wth_L_PEC_Latch , 
         i_Wth_R_PEC_Latch           := #s_CHO98_Wth_R_PEC_Latch , 
         o_Req_Halt_TRS              := #s_CHO98_Req_Halt_TRS , 
         o_Ready_To_Restart          := #s_CHO98_Ready_To_Restart , 
         o_ST_Check_Active           := #s_CHO98_ST_Check_Active , 
         o_ST_Hght_Fault             := #s_CHO98_ST_Hght_Fault , 
         o_ST_Left_Fault             := #s_CHO98_ST_Left_Fault , 
         o_ST_Right_Fault            := #s_CHO98_ST_Right_Fault , 
         o_ST_Front_Fault            := #s_CHO98_ST_Front_Fault , 
         o_ST_Rear_Fault             := #s_CHO98_ST_Rear_Fault , 
         o_ST_Unex_Empty             := #o_CHO98_ST_Unex_Empty , 
         o_ST_Unex_Loaded            := #o_CHO98_ST_Unex_Loaded , 
         o_ST_Suc_Unex_Empt          := #s_CHO98_ST_Suc_Unex_Empt , 
         o_ST_Suc_Unex_Load          := #s_CHO98_ST_Suc_Unex_Load
      );

      AN "M_Hardware_PN";
      JCN UA01;

      CALL #s_CHO98_FB_HW_ASI1
      (  i_Req_Output_1              := FALSE , 
         i_Req_Output_2              := FALSE , 
         i_Req_Output_3              := FALSE , 
         i_Req_Output_4              := FALSE , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Available_IO              := #i_IO_Available , 
         i_ASI_NotPrsnt              := #i_CHO98_ASI1_NotPrsnt , 
         i_Slave_Error               := #i_CHO98_ASI1_Error , 
         i_CFG_Delay_Time            := 0 , 
         o_ST_ASI_NotPrsnt           := #s_CHO98_ST_ASI1_NotPrsnt , 
         o_ST_ASI_Error              := #s_CHO98_ST_ASI1_Error , 
         o_IO_Output_1               := #t_Not_Used_Bool , 
         o_IO_Output_2               := #t_Not_Used_Bool , 
         o_IO_Output_3               := #t_Not_Used_Bool , 
         o_IO_Output_4               := #t_Not_Used_Bool
      );

      A #s_CHO98_ST_ASI1_NotPrsnt;
      = #s_CHO98_ST_FieldB1_NotPrsnt;
      A #s_CHO98_ST_ASI1_Error;
      = #s_CHO98_ST_FieldB1_Error;

      CALL #s_CHO98_FB_HW_ASI2
      (  i_Req_Output_1              := FALSE , 
         i_Req_Output_2              := FALSE , 
         i_Req_Output_3              := FALSE , 
         i_Req_Output_4              := FALSE , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Available_IO              := #i_IO_Available , 
         i_ASI_NotPrsnt              := #i_CHO98_ASI2_NotPrsnt , 
         i_Slave_Error               := #i_CHO98_ASI2_Error , 
         i_CFG_Delay_Time            := 0 , 
         o_ST_ASI_NotPrsnt           := #s_CHO98_ST_ASI2_NotPrsnt , 
         o_ST_ASI_Error              := #s_CHO98_ST_ASI2_Error , 
         o_IO_Output_1               := #t_Not_Used_Bool , 
         o_IO_Output_2               := #t_Not_Used_Bool , 
         o_IO_Output_3               := #t_Not_Used_Bool , 
         o_IO_Output_4               := #t_Not_Used_Bool
      );

      A #s_CHO98_ST_ASI2_NotPrsnt;
      = #s_CHO98_ST_FieldB2_NotPrsnt;
      A #s_CHO98_ST_ASI2_Error;
      = #s_CHO98_ST_FieldB2_Error;

      JU UA02;

UA01:      CALL #s_CHO98_FB_HW_Profinet1
      (  i_Req_Output_1              := FALSE , 
         i_Req_Output_2              := FALSE , 
         i_Req_Output_3              := FALSE , 
         i_Req_Output_4              := FALSE , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Available_IO              := #i_IO_Available , 
         i_CFG_Hardw_ID              := #i_CHO98_CFG_Hardw_ID1 , 
         i_CFG_Delay_Time            := 0 , 
         o_ST_FieldB_NotPrsnt        := #s_CHO98_ST_FieldB1_NotPrsnt , 
         o_ST_FieldB_Error           := #s_CHO98_ST_FieldB1_Error , 
         o_IO_Output_1               := #t_Not_Used_Bool , 
         o_IO_Output_2               := #t_Not_Used_Bool , 
         o_IO_Output_3               := #t_Not_Used_Bool , 
         o_IO_Output_4               := #t_Not_Used_Bool
      );

      CALL #s_CHO98_FB_HW_Profinet2
      (  i_Req_Output_1              := FALSE , 
         i_Req_Output_2              := FALSE , 
         i_Req_Output_3              := FALSE , 
         i_Req_Output_4              := FALSE , 
         i_CMD_Reset                 := #i_CMD_Reset , 
         i_Available_IO              := #i_IO_Available , 
         i_CFG_Hardw_ID              := #i_CHO98_CFG_Hardw_ID2 , 
         i_CFG_Delay_Time            := 0 , 
         o_ST_FieldB_NotPrsnt        := #s_CHO98_ST_FieldB2_NotPrsnt , 
         o_ST_FieldB_Error           := #s_CHO98_ST_FieldB2_Error , 
         o_IO_Output_1               := #t_Not_Used_Bool , 
         o_IO_Output_2               := #t_Not_Used_Bool , 
         o_IO_Output_3               := #t_Not_Used_Bool , 
         o_IO_Output_4               := #t_Not_Used_Bool
      );

UA02:      NOP 0;

      CALL #s_CHO98_FB_DAT_T
      (  i_ID                        := #i_CHO98_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_DB_PLT_Lost_And_Found     := #i_DB_PLT_Lost_And_Found , 
         i_DB_Send_FIFO_PNPN         := #i_DB_Send_FIFO_PNPN
      );

      CALL #s_CHO98_FB_DAT
      (  i_ID_Section                := #i_CHO98_ID , 
         i_DB_Event                  := "DB_Event_Section" , 
         i_PLC_Log_FIFO_DB           := "DB_LOG_Event_FIFO" , 
         i_CFG_BPI_Log_Level         := "DB_Setting".common.External_Log_Level , 
         i_CFG_PLC_Log_Level         := "DB_Setting".common.Internal_Log_Level , 
         i_CFG_PLC_Log_Route_Msgs    := FALSE , 
         i_CFG_PLC_LOG_BPI_Stat      := FALSE , 
         i_CFG_PLC_No_Msg_To_Rout    := FALSE , 
         i_CFG_PLC_No_Msg_To_BPI     := FALSE
      );

NETWORK
TITLE = VA: Send zone events
      NOP 0;

      CALL #s_FB_DAT_T
      (  i_ID                        := #i_ID , 
         i_DB_Event                  := "DB_Event_Zone"
      );

      CALL #s_FB_DAT
      (  i_ID_Section                := #i_ID , 
         i_DB_Event                  := "DB_Event_Zone" , 
         i_PLC_Log_FIFO_DB           := "DB_LOG_Event_FIFO" , 
         i_CFG_BPI_Log_Level         := "DB_Setting".common.External_Log_Level , 
         i_CFG_PLC_Log_Level         := "DB_Setting".common.Internal_Log_Level , 
         i_CFG_PLC_Log_Route_Msgs    := FALSE , 
         i_CFG_PLC_LOG_BPI_Stat      := FALSE , 
         i_CFG_PLC_No_Msg_To_Rout    := FALSE , 
         i_CFG_PLC_No_Msg_To_BPI     := FALSE
      );

NETWORK
TITLE = WA: Write Zone outputs
      NOP 0;

// Request carrier active = Action active
      AN #s_TRS02_Ext_Req_Dis_Send;
      O #t_TRS04_Release_Carrier;
      S #s_Request_Active;

// The Carrier has left TRS04
      A #t_TRS04_Carrier_Trail_Behind_LP;
      FN #s_FN_Carrier_Behind_Load_Point;
      R #s_Request_Active;

// Write Action active
      A #s_Request_Active;
      O(;
      A #s_CHO98_ST_Check_Active;// When trailing edge of carrier has left TRS04, CHO check is active
      A #t_TRS05_Motor_Run;
      );
      = #o_Action_Active;

// Ready to restart
      A #s_TRS01_Ready_To_Restart;
      O #s_TRS02_Ready_To_Restart;
      O #s_TRS03_Ready_To_Restart;
      O #s_IDO99_EQP_Rdy_To_Start;
      O #s_IDO99_HW_Rdy_To_Start;
      O #s_TRS04_Ready_To_Restart;
      O #s_TRS05_Ready_To_Restart;
      O #s_CHO98_Ready_To_Restart;
      = #o_Ready_To_Restart;

// Semi-automatic mode fixed flush
      A #s_ST_Fixed_Flush_Mode;
      = #o_ST_Fixed_Flush_Mode;

NETWORK
TITLE = WB: Write outputs TRS01
      NOP 0;

      A #s_TRS01_ST_LMS_Not_Prsnt;
      = #o_TRS01_ST_LMS_Not_Prsnt;
      A #s_TRS01_ST_LMS_Error;
      = #o_TRS01_ST_LMS_Error;
      A #s_TRS01_ST_Items;
      = #o_TRS01_ST_Items;
      A #s_TRS01_ST_LMS_Not_Auto;
      = #o_TRS01_ST_LMS_Not_Auto;
      A #s_TRS01_ST_LMS_Not_Hthy;
      = #o_TRS01_ST_LMS_Not_Hthy;
      A #s_TRS01_ST_EOS_PEC_Blk;
      = #o_TRS01_ST_EOS_PEC_Blk;
      A #s_TRS01_ST_EOS_PEC_Miss;
      = #o_TRS01_ST_EOS_PEC_Miss;

NETWORK
TITLE = WC: Write outputs TRS02
      NOP 0;

      A #s_TRS02_ST_LMS_Not_Prsnt;
      = #o_TRS02_ST_LMS_Not_Prsnt;
      A #s_TRS02_ST_LMS_Error;
      = #o_TRS02_ST_LMS_Error;
      A #s_TRS02_ST_ASI_Not_Prsnt;
      = #o_TRS02_ST_ASI_Not_Prsnt;
      A #s_TRS02_ST_ASI_Error;
      = #o_TRS02_ST_ASI_Error;
      A #s_TRS02_ST_FieldB_Not_Prsnt;
