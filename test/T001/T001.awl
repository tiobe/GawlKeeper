//Description:
//The function of LDZ02 is to load the baggage items in to carriers. Standard bag
//presented to the LDZ02 will be loaded. The upstream system is responsible to
//provide only standard Bags, with a maximum length of 1000 mm. All carriers
//entering the LDZ shall be transported to TRS05, and shall be stopped at the end of TRS04.
//Next to loading carriers the LDZ can release carriers for operator requests and TFC.
   VAR_INPUT 
      i_ID : DWord;   // ID Record HEX AAAAZZSS/OO
      i_Command : "UDT_LDZ02_Cmd_T";   // Data Structure: Command
      i_CMD_Enable : Bool;   // CMD: Enable command
      i_CMD_Start : Bool;   // CMD: Start command
      i_CMD_Reset : Bool;   // CMD: Reset command
      i_CMD_Controlled_Stop : Bool;   // CMD: Controlled stop command
      i_IO_Available : Bool;   // IO is OK signal (no fieldbus or IO error)
      i_Safety_OK : Bool;   // Safety is OK signal
      i_Send_Statistics : Bool;   // Trigger send and clear statistics
      i_CFG_Blockage_Length : Int;   // CFG: [cm] Delay for detecting a PEC blockage
      i_CFG_Default_Record_TTT : Int;   // CFG: Number of default record to be used to create link in tubtrax
      i_CFG_Default_Record_Raw : Int;   // CFG: Number of default record to be used to create link in raw baggage
      i_CFG_Default_Record_ECS : Int;   // CFG: Number of default record with only ECS record
      i_CFG_Default_Record_LIC : Int;   // CFG: Default record LIC
      i_CFG_Reset_Req_TFC : Bool;   // CFG: The "Requested by TFC" status will be reset
      i_CFG_Loading_Trigger_Point : Int;   // CFG: [cm] Position from EOS TRS02 where the load action is triggered
      i_DB_PLT_Lost_And_Found : DB_ANY := DB1;   // Data Structure: DB PLT lost & found buffer
      i_DB_Send_FIFO_PNPN : DB_ANY := DB1;   // Data Structure: TCTC DB send message FIFO for PN/PN coupler
      i_DB_PLT_Dwnstr : DB_ANY := DB1;   // Data Structure: DB PLT downstream
      i_DB_RS_Upstr : DB_ANY := DB1;   // Data Structure: DB Route Segment upstream buffer
      i_DB_RS_Dwnstr : DB_ANY := DB1;   // Data Structure: DB Route Segment downstream buffer
      i_DB_RelCtrl : DB_ANY := DB1;   // Data Structure: DB release control
      i_DB_Carrier_Req : DB_ANY := DB1;   // Data Structure: Carrier requests
      i_DB_VirtBagInstr : DB_ANY := DB1;   // Data Structure: DB Virtual Bag Instruction
      i_DB_PLT_VirtBag : DB_ANY := DB1;   // Data Structure: DB PLT Virtual Bags
      i_VirtBag_Reg_ID : DWord;   // ID Record HEX AAAAZZSS/OO Registration Virtual Bag
      i_VirtBag_Scan_ID : DWord;   // ID Record HEX AAAAZZSS/OO Scan Result Virtual Bag
      i_TRS01_ID : DWord;   // ID Record HEX AAAAZZSS/OO
      i_TRS01_Setting : "UDT_TRS_T1D1S1P_Sett";   // Data Structure: Setting
      i_TRS01_CFG_LMS_In_Hardw_ID : HW_ANY;   // CFG: Hardware ID of the module from which the data is to be read
      i_TRS01_CFG_LMS_Out_Hardw_ID : HW_ANY;   // CFG: Hardware ID of the module to which the data is to be written
      i_TRS01_Ext_Req_Halt : Bool;   // Request signal from external to halt (no restart needed)
      i_TRS01_Ext_Req_Rst_ESav : Bool;   // Request signal from external to reset energy saving
      i_TRS01_DB_PLT : DB_ANY := DB1;   // Data Structure: DB PLT
      i_TRS01_LMS_Not_Prsnt : Bool;   // LMS ASI slave not present
      i_TRS01_LMS_Error : Bool;   // LMS ASI slave error
      i_TRS01_IO_LMS_Auto : Bool;   // HW: Automatic signal from LMS
      i_TRS01_IO_LMS_Healthy : Bool;   // HW: Healthy signal from LMS
      i_TRS01_IO_NOT_EOS_PEC : Bool;   // HW: End Of Section PEC (TRUE = No product detected)
