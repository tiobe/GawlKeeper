      = #o_CHO98_ST_FieldB2_Error;
      A #s_CHO98_ST_Trg_PEC_Blk;
      = #o_CHO98_ST_Trg_PEC_Blk;
      A #s_CHO98_ST_Gap_PEC_Blk;
      = #o_CHO98_ST_Gap_PEC_Blk;
