      = #o_CHO98_ST_Len_PEC_Blk;
      A #s_CHO98_ST_Con_L_PEC_Blk;
      = #o_CHO98_ST_Con_L_PEC_Blk;
      A #s_CHO98_ST_Con_R_PEC_Blk;
      = #o_CHO98_ST_Con_R_PEC_Blk;
      A #s_CHO98_ST_Wth_L_PEC_Blk;
      = #o_CHO98_ST_Wth_L_PEC_Blk;
      A #s_CHO98_ST_Wth_R_PEC_Blk;
      = #o_CHO98_ST_Wth_R_PEC_Blk;
      A #s_CHO98_ST_Hght_Fault;
      = #o_CHO98_ST_Hght_Fault;
      A #s_CHO98_ST_Left_Fault;
      = #o_CHO98_ST_Left_Fault;
      A #s_CHO98_ST_Right_Fault;
      = #o_CHO98_ST_Right_Fault;
