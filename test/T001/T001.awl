      = #o_TRS02_ST_LMS_Not_Auto;
      A #s_TRS02_ST_LMS_Not_Hthy;
      = #o_TRS02_ST_LMS_Not_Hthy;
      A #s_TRS02_ST_EOS_PEC_Blk;
      = #o_TRS02_ST_EOS_PEC_Blk;
      A #s_TRS02_ST_EOS_PEC_Miss;
      = #o_TRS02_ST_EOS_PEC_Miss;
      A #s_TRS02_ST_Chk1_PEC_Blk;
      = #o_TRS02_ST_Chk1_PEC_Blk;
      A #s_TRS02_ST_Chk2_PEC_Blk;
      = #o_TRS02_ST_Chk2_PEC_Blk;

NETWORK
TITLE = WD: Write outputs TRS03
      NOP 0;

      A #s_TRS03_ST_LMS_Not_Prsnt;
      = #o_TRS03_ST_LMS_Not_Prsnt;
      A #s_TRS03_ST_LMS_Error;
      = #o_TRS03_ST_LMS_Error;
