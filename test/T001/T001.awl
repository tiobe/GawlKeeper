      = #o_TRS03_ST_LMS_Not_Hthy;
      A #s_TRS03_ST_EOS_PEC_Blk;
      = #o_TRS03_ST_EOS_PEC_Blk;
      A #s_TRS03_ST_EOS_PEC_Miss;
      = #o_TRS03_ST_EOS_PEC_Miss;

NETWORK
TITLE = WE: Write outputs IDO99
      NOP 0;

      A #s_IDO99_ST_PN_Not_Prsnt;
      = #o_IDO99_ST_PN_Not_Prsnt;
      A #s_IDO99_ST_PN_Error;
