      = #o_CHO98_ST_FieldB1_Error;
      A #s_CHO98_ST_ASI2_NotPrsnt;
      = #o_CHO98_ST_ASI2_NotPrsnt;
      A #s_CHO98_ST_ASI2_Error;
      = #o_CHO98_ST_ASI2_Error;
      A #s_CHO98_ST_FieldB2_NotPrsnt;
      = #o_CHO98_ST_FieldB2_Not_Prsnt;
